#!/usr/bin/env bash
set -euo pipefail

# Give xclip a short moment to become the clipboard owner before pasting.
sleep "${VOXTYPE_PASTE_DELAY:-0.12}"

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/voxtype"
EXPECTED_PASTE="$STATE_DIR/expected_paste_text"
SAVED_CORRECTION_PENDING="$STATE_DIR/saved_correction_pending"
SAVED_CLIPBOARD="$STATE_DIR/saved_clipboard"
SAVED_STATE="$STATE_DIR/saved_clipboard_state"
POPUP_UI="${VOXTYPE_POPUP_UI:-$HOME/.local/bin/voxpress-popup-ui}"
CLIPBOARD_NOW="$(mktemp)"
EXPECTED_TRIMMED="$(mktemp)"

cleanup() {
  rm -f "$CLIPBOARD_NOW" "$EXPECTED_TRIMMED"
}
trap cleanup EXIT

restore_clipboard() {
  if [[ ! -f "$SAVED_STATE" ]]; then
    return
  fi

  case "$(cat "$SAVED_STATE" 2>/dev/null || true)" in
    present)
      /usr/bin/xclip -selection clipboard -i "$SAVED_CLIPBOARD" >/dev/null 2>&1 &
      ;;
    absent)
      { printf '' | /usr/bin/xclip -selection clipboard -i >/dev/null 2>&1; } &
      ;;
  esac
}

hide_popup() {
  "$POPUP_UI" hide >/dev/null 2>&1 || true
}

show_saved_correction_if_pending() {
  if [[ ! -f "$SAVED_CORRECTION_PENDING" ]]; then
    return
  fi

  local now marker_mtime max_age reference_window
  now="$(date +%s)"
  marker_mtime="$(stat -c %Y "$SAVED_CORRECTION_PENDING" 2>/dev/null || printf '0')"
  max_age="${VOXPRESS_SAVED_CORRECTION_MAX_AGE:-30}"
  if (( now - marker_mtime > max_age )); then
    rm -f "$SAVED_CORRECTION_PENDING"
    return
  fi

  reference_window="$(cat "$SAVED_CORRECTION_PENDING" 2>/dev/null || true)"
  rm -f "$SAVED_CORRECTION_PENDING"
  if [[ -n "$reference_window" ]]; then
    "$POPUP_UI" saved-correction --reference-window "$reference_window" >/dev/null 2>&1 || true
  else
    "$POPUP_UI" saved-correction >/dev/null 2>&1 || true
  fi
}

exit_without_paste() {
  restore_clipboard
  hide_popup
  show_saved_correction_if_pending
  exit 0
}

if [[ ! -f "$EXPECTED_PASTE" ]]; then
  exit_without_paste
fi

NOW="$(date +%s)"
EXPECTED_MTIME="$(stat -c %Y "$EXPECTED_PASTE" 2>/dev/null || printf '0')"
EXPECTED_MAX_AGE="${VOXTYPE_EXPECTED_PASTE_MAX_AGE:-20}"
if (( NOW - EXPECTED_MTIME > EXPECTED_MAX_AGE )); then
  rm -f "$EXPECTED_PASTE"
  exit_without_paste
fi

if ! /usr/bin/xclip -selection clipboard -o >"$CLIPBOARD_NOW" 2>/dev/null; then
  exit_without_paste
fi

MATCH_MODE=exact
if ! cmp -s "$EXPECTED_PASTE" "$CLIPBOARD_NOW"; then
  /usr/bin/python3 - "$EXPECTED_PASTE" "$EXPECTED_TRIMMED" <<'PY'
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
target.write_bytes(source.read_bytes().rstrip(b"\n"))
PY
  if cmp -s "$EXPECTED_TRIMMED" "$CLIPBOARD_NOW"; then
    MATCH_MODE=restore-trailing-newline
  else
    exit_without_paste
  fi
fi

if [[ -n "${VOXTYPE_XDOTOOL:-}" ]]; then
  XDOTOOL="$VOXTYPE_XDOTOOL"
elif [[ -n "${VOXPRESS_XDOTOOL:-}" ]]; then
  XDOTOOL="$VOXPRESS_XDOTOOL"
elif command -v xdotool >/dev/null 2>&1; then
  XDOTOOL="$(command -v xdotool)"
elif [[ -x "$HOME/.local/share/voxtype/xdotool-env/bin/xdotool" ]]; then
  XDOTOOL="$HOME/.local/share/voxtype/xdotool-env/bin/xdotool"
else
  XDOTOOL="xdotool"
fi
WINDOW_CLASS="$("$XDOTOOL" getactivewindow getwindowclassname 2>/dev/null || true)"

case "${WINDOW_CLASS,,}" in
  kitty|gnome-terminal|org.gnome.terminal|alacritty|wezterm|konsole|xterm)
    PASTE_KEYS="${VOXTYPE_TERMINAL_PASTE_KEYS:-ctrl+shift+v}"
    ;;
  *)
    PASTE_KEYS="${VOXTYPE_PASTE_KEYS:-shift+Insert}"
    ;;
esac

if [[ "${VOXTYPE_PASTE_DRY_RUN:-0}" == "1" ]]; then
  printf 'paste_keys=%s window_class=%s match_mode=%s\n' "$PASTE_KEYS" "$WINDOW_CLASS" "$MATCH_MODE"
  rm -f "$EXPECTED_PASTE"
  exit_without_paste
fi

if [[ "$MATCH_MODE" == "restore-trailing-newline" ]]; then
  /usr/bin/xclip -selection clipboard -i "$EXPECTED_PASTE" >/dev/null 2>&1 &
  sleep "${VOXTYPE_REPAIR_CLIPBOARD_DELAY:-0.08}"
fi

rm -f "$EXPECTED_PASTE"

if ! "$XDOTOOL" key --clearmodifiers "$PASTE_KEYS"; then
  exit_without_paste
fi
sleep "${VOXTYPE_RESTORE_CLIPBOARD_DELAY:-0.45}"
restore_clipboard
hide_popup
show_saved_correction_if_pending
