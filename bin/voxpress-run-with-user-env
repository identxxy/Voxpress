#!/usr/bin/env python3
import os
import subprocess
import sys
import time


GRAPHICAL_ENV_KEYS = (
    "DISPLAY",
    "XAUTHORITY",
    "WAYLAND_DISPLAY",
    "XDG_CURRENT_DESKTOP",
    "XDG_SESSION_TYPE",
    "DESKTOP_SESSION",
)


def load_user_manager_environment():
    systemctl = os.environ.get("VOXPRESS_SYSTEMCTL", "systemctl")
    try:
        result = subprocess.run(
            [systemctl, "--user", "show-environment"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0:
        return False

    changed = False
    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key not in GRAPHICAL_ENV_KEYS or not value:
            continue
        if os.environ.get(key) == value:
            continue
        os.environ[key] = value
        changed = True
    return changed


def wait_for_graphical_environment():
    timeout_seconds = float(os.environ.get("VOXPRESS_GRAPHICAL_ENV_TIMEOUT_SECONDS", "60"))
    deadline = time.monotonic() + max(0.0, timeout_seconds)
    while True:
        if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            return True
        load_user_manager_environment()
        if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def main():
    if len(sys.argv) < 2:
        print("usage: voxpress-run-with-user-env COMMAND [ARG ...]", file=sys.stderr)
        return 64

    wait_for_graphical_environment()
    os.execvp(sys.argv[1], sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
