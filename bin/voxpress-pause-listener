#!/usr/bin/python3
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path


CONFIG_PATH = os.environ.get(
    "VOXTYPE_POPUP_SETTINGS",
    os.environ.get("VOXPRESS_SETTINGS", os.path.expanduser("~/.config/voxpress/settings.json")),
)
DEFAULT_TRIGGER_KEY = os.environ.get("VOXTYPE_TRIGGER_KEY", "Pause")
KEYCODE_OVERRIDE = os.environ.get("VOXTYPE_PAUSE_KEYCODE")
VOXTYPE = os.environ.get("VOXTYPE_BIN", "voxtype")
SYSTEMCTL = os.environ.get("VOXPRESS_SYSTEMCTL", "systemctl")
POPUP_UI = os.environ.get(
    "VOXTYPE_POPUP_UI", os.path.expanduser("~/.local/bin/voxpress-popup-ui")
)
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/tmp/voxtype-{os.getuid()}")
STATE_DIR = os.path.join(RUNTIME_DIR, "voxtype")
TARGET_WINDOW_FILE = os.path.join(STATE_DIR, "target_window")
EXPECTED_PASTE_FILE = os.path.join(STATE_DIR, "expected_paste_text")
CORRECTION_AUDIO_FILE = os.path.join(STATE_DIR, "correction_audio_path")
CORRECTION_AUDIO_DURATION_FILE = os.path.join(STATE_DIR, "correction_audio_duration")
AUDIO_CAPTURE_DIR = os.path.join(STATE_DIR, "correction-audio")
DRY_RUN = os.environ.get("VOXTYPE_PAUSE_DRY_RUN", "0") == "1"
MIN_RECORDING_MS = int(os.environ.get("VOXTYPE_MIN_RECORDING_MS", "650"))

recording = False
target_window = None
recording_started_at = 0.0
audio_capture_proc = None
audio_capture_path = None
audio_capture_started_at = 0.0
trigger_key = DEFAULT_TRIGGER_KEY
trigger_keycodes = {KEYCODE_OVERRIDE} if KEYCODE_OVERRIDE else set()
settings_mtime = None

KEY_NAMES = {
    "Pause",
    "Scroll_Lock",
    "Return",
    "Escape",
    "Delete",
    "BackSpace",
    "Insert",
    "F9",
    "F10",
    "F11",
    "F12",
    "XF86AudioMicMute",
    "XF86AudioRecord",
    "XF86AudioPlay",
}

KEY_ALIASES = {
    "Enter": "Return",
    "Scroll Lock": "Scroll_Lock",
    "Backspace": "BackSpace",
}

KEY_LABELS = {
    "Pause": "Pause",
    "Scroll_Lock": "Scroll Lock",
    "Return": "Enter",
    "Escape": "Escape",
    "Delete": "Delete",
    "BackSpace": "Backspace",
    "Insert": "Insert",
    "F9": "F9",
    "F10": "F10",
    "F11": "F11",
    "F12": "F12",
    "XF86AudioMicMute": "Mic mute",
    "XF86AudioRecord": "Audio Record",
    "XF86AudioPlay": "Audio Play/Pause",
}

GRAPHICAL_ENV_KEYS = ("DISPLAY", "XAUTHORITY")


def log(message: str) -> None:
    print(message, flush=True)


def resolve_xdotool():
    configured = os.environ.get("VOXTYPE_XDOTOOL") or os.environ.get("VOXPRESS_XDOTOOL")
    if configured:
        return configured
    bundled = os.path.expanduser("~/.local/share/voxtype/xdotool-env/bin/xdotool")
    return shutil.which("xdotool") or (bundled if os.path.isfile(bundled) else "xdotool")


XDOTOOL = resolve_xdotool()


def import_user_manager_environment() -> dict[str, str]:
    try:
        result = subprocess.run(
            [SYSTEMCTL, "--user", "show-environment"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if result.returncode != 0:
        return {}

    updated = {}
    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key not in GRAPHICAL_ENV_KEYS or not value:
            continue
        if os.environ.get(key) == value:
            continue
        os.environ[key] = value
        updated[key] = value
    return updated


def ensure_x11_environment() -> bool:
    updated = import_user_manager_environment()
    if updated:
        log("Imported X11 environment from user manager: " + ", ".join(sorted(updated)))
    return bool(os.environ.get("DISPLAY"))


def normalize_key_name(value: str | None, default: str = DEFAULT_TRIGGER_KEY) -> str:
    value = str(value or default)
    value = KEY_ALIASES.get(value, value)
    return value if value in KEY_NAMES else default


def key_label(key_name: str) -> str:
    return KEY_LABELS.get(key_name, key_name.replace("_", " "))


def load_trigger_key() -> str:
    env_key = os.environ.get("VOXTYPE_TRIGGER_KEY")
    if env_key:
        return normalize_key_name(env_key)

    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as handle:
            settings = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return DEFAULT_TRIGGER_KEY
    return normalize_key_name(settings.get("trigger_key"), DEFAULT_TRIGGER_KEY)


def load_settings() -> dict:
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    return raw if isinstance(raw, dict) else {}


def bool_from_env(value: str | None) -> bool | None:
    if value is None:
        return None
    normalized = value.strip().lower()
    if normalized in ("1", "true", "yes", "on"):
        return True
    if normalized in ("0", "false", "no", "off"):
        return False
    return None


def correction_collection_enabled() -> bool:
    override = bool_from_env(os.environ.get("VOXPRESS_CORRECTION_COLLECTION"))
    if override is not None:
        return override
    return bool(load_settings().get("correction_collection_enabled", True))


def keycodes_for_key_name(key_name: str) -> set[str]:
    if KEYCODE_OVERRIDE:
        return {KEYCODE_OVERRIDE}

    try:
        result = subprocess.run(
            ["/usr/bin/xmodmap", "-pke"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None

    keycodes = set()
    if result:
        for line in result.stdout.splitlines():
            match = re.match(r"keycode\s+(\d+)\s+=\s+(.*)", line)
            if not match:
                continue
            keycode, symbols = match.groups()
            if key_name in symbols.split():
                keycodes.add(keycode)

    if not keycodes and key_name == "Pause":
        keycodes.add("127")
    return keycodes


def refresh_trigger_keycodes(force: bool = False) -> set[str]:
    global trigger_key, trigger_keycodes, settings_mtime
    if KEYCODE_OVERRIDE:
        return trigger_keycodes

    try:
        mtime = os.path.getmtime(CONFIG_PATH)
    except OSError:
        mtime = None

    if not force and mtime == settings_mtime and trigger_keycodes:
        return trigger_keycodes

    next_key = load_trigger_key()
    next_keycodes = keycodes_for_key_name(next_key)
    if not next_keycodes:
        log(f"Could not resolve key {next_key}; falling back to Pause")
        next_key = "Pause"
        next_keycodes = keycodes_for_key_name(next_key)

    if force or next_key != trigger_key or next_keycodes != trigger_keycodes:
        log(f"Listening for {key_label(next_key)} keycodes: {', '.join(sorted(next_keycodes))}")
    trigger_key = next_key
    trigger_keycodes = next_keycodes
    settings_mtime = mtime
    return trigger_keycodes


def run_voxtype(action: str) -> None:
    cmd = [VOXTYPE, "record", action]
    if DRY_RUN:
        log(f"dry-run: {' '.join(cmd)}")
        return

    try:
        subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"voxtype record {action} failed: {exc}")


def voxtype_status() -> str | None:
    if DRY_RUN:
        return "idle"
    try:
        result = subprocess.run(
            [VOXTYPE, "status"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() or None


def clear_expected_paste() -> None:
    try:
        os.unlink(EXPECTED_PASTE_FILE)
    except FileNotFoundError:
        pass
    except OSError:
        pass


def clear_pending_correction_audio(unlink_audio: bool = False) -> None:
    audio_path = None
    try:
        with open(CORRECTION_AUDIO_FILE, encoding="utf-8") as handle:
            audio_path = handle.read().strip()
    except OSError:
        audio_path = None

    for path in (CORRECTION_AUDIO_FILE, CORRECTION_AUDIO_DURATION_FILE):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError:
            pass

    if unlink_audio and audio_path:
        try:
            Path(audio_path).unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass


def audio_capture_command(path: str) -> list[str]:
    template = os.environ.get("VOXPRESS_AUDIO_CAPTURE_CMD")
    if template:
        return shlex.split(template.format(path=path))

    device = os.environ.get("VOXPRESS_AUDIO_DEVICE", "@DEFAULT_SOURCE@")
    return [
        "parec",
        "--record",
        "--file-format=wav",
        "--format=s16le",
        "--rate=16000",
        "--channels=1",
        f"--device={device}",
        path,
    ]


def start_correction_audio_capture() -> bool:
    global audio_capture_proc, audio_capture_path, audio_capture_started_at
    if not correction_collection_enabled():
        return False
    if DRY_RUN:
        return False
    if audio_capture_proc is not None:
        return False

    clear_pending_correction_audio(unlink_audio=True)
    try:
        os.makedirs(AUDIO_CAPTURE_DIR, exist_ok=True)
    except OSError:
        return False

    audio_capture_path = os.path.join(AUDIO_CAPTURE_DIR, f"{uuid.uuid4().hex}.wav")
    cmd = audio_capture_command(audio_capture_path)
    try:
        audio_capture_proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log(f"correction audio capture failed to start: {exc}")
        audio_capture_proc = None
        audio_capture_path = None
        return False

    audio_capture_started_at = time.monotonic()
    return True


def stop_correction_audio_capture(keep: bool) -> None:
    global audio_capture_proc, audio_capture_path, audio_capture_started_at
    proc = audio_capture_proc
    path = audio_capture_path
    started_at = audio_capture_started_at
    audio_capture_proc = None
    audio_capture_path = None
    audio_capture_started_at = 0.0

    if proc is not None:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass

    if not path:
        clear_pending_correction_audio(unlink_audio=not keep)
        return

    size = 0
    try:
        size = os.path.getsize(path)
    except OSError:
        size = 0

    if keep and size > 44:
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(CORRECTION_AUDIO_FILE, "w", encoding="utf-8") as handle:
                handle.write(path)
            with open(CORRECTION_AUDIO_DURATION_FILE, "w", encoding="utf-8") as handle:
                handle.write(f"{max(0.0, time.monotonic() - started_at):.3f}")
            return
        except OSError:
            pass

    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError:
        pass
    clear_pending_correction_audio(unlink_audio=False)


def get_active_window() -> str | None:
    try:
        result = subprocess.run(
            [XDOTOOL, "getactivewindow"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None

    window = result.stdout.strip()
    return window or None


def save_target_window(window: str | None) -> None:
    if not window:
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(TARGET_WINDOW_FILE, "w", encoding="utf-8") as handle:
            handle.write(window)
    except OSError:
        pass


def popup(command: str, window: str | None = None) -> None:
    if DRY_RUN:
        log(f"dry-run: {POPUP_UI} {command}")
        return
    cmd = [POPUP_UI, command]
    if window:
        cmd.extend(["--reference-window", window])

    try:
        subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"popup {command} failed: {exc}")


def start_recording() -> None:
    global recording, target_window, recording_started_at
    if recording:
        return
    status = voxtype_status()
    if status not in (None, "idle"):
        log(f"Pause pressed: ignored while voxtype status is {status}")
        return

    recording = True
    recording_started_at = time.monotonic()
    target_window = get_active_window()
    save_target_window(target_window)
    clear_expected_paste()
    start_correction_audio_capture()
    log(f"{key_label(trigger_key)} pressed: start recording")
    popup("recording", target_window)
    run_voxtype("start")


def stop_recording() -> None:
    global recording, recording_started_at
    if not recording:
        return
    recording = False
    duration_ms = int((time.monotonic() - recording_started_at) * 1000)
    if duration_ms < MIN_RECORDING_MS:
        log(f"{key_label(trigger_key)} released after {duration_ms}ms: cancel short recording")
        popup("hide", target_window)
        clear_expected_paste()
        stop_correction_audio_capture(keep=False)
        run_voxtype("cancel")
        return

    log(f"{key_label(trigger_key)} released: stop recording")
    popup("transcribing", target_window)
    stop_correction_audio_capture(keep=True)
    run_voxtype("stop")


def cancel_recording() -> None:
    global recording
    popup("hide", target_window)
    clear_expected_paste()
    stop_correction_audio_capture(keep=False)
    if recording:
        recording = False
        run_voxtype("cancel")


def handle_signal(signum, frame) -> None:
    cancel_recording()
    raise SystemExit(0)


def event_stream():
    cmd = ["/usr/bin/stdbuf", "-oL", "/usr/bin/xinput", "test-xi2", "--root"]
    while True:
        if not ensure_x11_environment():
            log("X11 DISPLAY is unavailable; waiting before starting xinput")
            time.sleep(1)
            continue

        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        try:
            yield from proc.stdout
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()

        log("xinput stream ended; restarting in 1s")
        time.sleep(1)


def main() -> int:
    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    ensure_x11_environment()
    refresh_trigger_keycodes(force=True)
    pending_event = None
    for line in event_stream():
        stripped = line.strip()
        if stripped.startswith("EVENT type 2 (KeyPress)"):
            pending_event = "press"
            continue
        if stripped.startswith("EVENT type 3 (KeyRelease)"):
            pending_event = "release"
            continue
        if pending_event and stripped.startswith("detail:"):
            detail = stripped.split(":", 1)[1].strip().split()[0]
            if detail in refresh_trigger_keycodes():
                if pending_event == "press":
                    start_recording()
                else:
                    stop_recording()
            pending_event = None

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
